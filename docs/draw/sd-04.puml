@startuml
title SD-04 Интеллектуальный подбор техники
actor "Пользователь" as U
participant "RAC-system" as S
participant "Языковая модель" as L
database "История" as H
U -> S : Открыть главную страницу
S --> U : Показать форму подбора
U -> S : Отправить вид техники и объём земель
alt A2. Обязательные поля не заполнены
S --> U : Выделить незаполненные поля
else Поля заполнены
S -> L : Передать параметры запроса
alt A1. Параметры запроса не распознаны
L --> S : Параметры неоднозначны
S --> U : Предложить уточнить запрос
else A3. Подходящие варианты отсутствуют
L --> S : Пустой список
S --> U : Предложить изменить запрос или открыть каталог
else A4. Сервис модели недоступен
S --> U : Сообщить о недоступности и предложить каталог
else Основной поток. Подбор выполнен
L --> S : Вернуть список рекомендаций
S -> H : Сохранить запрос и результаты
S --> U : Показать рекомендации, характеристики и цены
U -> S : Выбрать интересующую позицию
S --> U : Показать сведения о технике и переход к заявке
end
end
@enduml
